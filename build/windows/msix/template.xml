<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="xinskillvault.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Xin\Xin Skill Vault">
    </Installer>
    <PackageInformation
        PackageName="Xin Skill Vault"
        PackageDisplayName="Xin Skill Vault"
        PublisherName="CN=Xin"
        PublisherDisplayName="Xin"
        Version="0.1.0.0"
        PackageDescription="AI Agent Skill Vault">
